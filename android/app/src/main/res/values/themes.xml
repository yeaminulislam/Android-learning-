<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Prakriti" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/green_primary</item>
        <item name="android:colorPrimaryDark">@color/green_dark</item>
        <item name="android:colorAccent">@color/moss</item>
        <item name="android:colorControlActivated">@color/green_primary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:navigationBarColor">@color/green_dark</item>
        <item name="android:statusBarColor">@color/green_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowActivityTransitions">true</item>
    </style>

    <style name="Theme.Prakriti.Splash" parent="Theme.Prakriti">
        <item name="android:windowBackground">@color/green_dark</item>
    </style>

    <style name="Text.Display" parent="android:TextAppearance.Material">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Title" parent="android:TextAppearance.Material">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Body" parent="android:TextAppearance.Material">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>

    <style name="Text.Caption" parent="android:TextAppearance.Material">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="Text.Label" parent="android:TextAppearance.Material">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
</resources>
